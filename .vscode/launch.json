{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Typer: Run Command",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "run",
                "--config", "config.yaml"
            ]
        },
        {
            "name": "Typer: Generate Command (Fixed Args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "generate",
                "my_pipeline_name",
                "--config", "config.yaml"
            ]
        },
        {
            "name": "Typer: Generate Command (with file)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "generate",
                "idea1",              
                "--input", "C:\\Users\\soura\\Downloads\\AutomatedZero-TrustSupportAgentArchitecturev2.0.md",  
                "--config", "config.yaml"
            ]
        }
    ],
    "inputs": [
        {
            "id": "pipelineName",
            "type": "promptString",
            "description": "Enter the pipeline name argument:",
            "default": "my_pipeline_name"
        }
    ]
}
